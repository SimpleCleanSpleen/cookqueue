rules_version = '2';

// PrepDash — Firestore security rules.
//
// These rules are what actually protect the data (the website code can be
// changed by anyone in their own browser; these can't). Publish them in
// Firebase console → Firestore Database → Rules: paste this whole file and
// click Publish. Re-publish whenever this file changes.
//
//  - Anyone can read recipes and usernames (the menu is public).
//  - Only a signed-in user can create a recipe, and it's stamped as theirs.
//  - Only the owner can edit or delete a recipe, and nobody can change its owner.
//  - Usernames are unique (case-insensitive) and only you can set yours.
//  - Ratings can't be written yet (they arrive with reviews later).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUsername() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if true;

      // Create or rename. The matching usernames/{lower} doc must point back
      // at this user once the write finishes (setUsername writes both at once).
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;

      allow delete: if false;
    }

    match /usernames/{name} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == name;

      // Releasing your old name when you rename.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower != name;

      allow update: if false;
    }

    match /recipes/{recipeId} {
      allow read: if true;

      // Light shape checks. The site runs the full PrepDash rule check before
      // saving and hides any recipe that fails it.
      function validRecipe() {
        let d = request.resource.data;
        return recipeId.matches('^[a-z0-9-]{3,80}$')
          && !d.keys().hasAny(['id', 'rating', 'ratingCount', 'community'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.category in ['main', 'dessert', 'snack']
          && d.ingredients is list && d.ingredients.size() <= 10
          && d.steps is list && d.steps.size() > 0 && d.steps.size() <= 40
          && d.image is map && d.image.url is string && d.image.url.size() <= 400000;
      }

      allow create: if signedIn() && hasUsername()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validRecipe();

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validRecipe();

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
