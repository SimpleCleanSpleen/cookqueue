rules_version = '2';

// CookQueue Firestore security rules: the real protection for the data.
// To publish, paste this whole file into Firebase console → Firestore → Rules.
//
//  - Anyone can read recipes, usernames and the barcode catalog.
//  - Signed-in users with a username can create recipes (stamped as theirs)
//    and add new barcodes.
//  - Only the owner edits or deletes a recipe; the owner can't be changed.
//  - Usernames are unique (case-insensitive) and only you can set yours.
//  - Only whoever added a barcode can correct it; nobody deletes one.
//  - Reviews: one per person per recipe (recipes/{id}/reviews/{uid}), 1–5
//    stars + optional comment; anyone reads, only the reviewer writes/deletes.
//  - Site recipes (shipped in js/data, ids listed in siteRecipeId() below)
//    belong to the site owner, the username in siteOwner(). Only they can
//    create the Firestore copy of one or hide one (hidden_recipes).
//  - Recipe docs can't carry rating fields; ratings are computed from reviews.
//  - failed_recipe_imports is a write-only debug log (Recipe Helper): signed-in
//    users can create a capped, size-limited entry stamped as their own;
//    nobody can read, edit or delete it from the app. Give it a Firestore TTL
//    policy on `createdAt` in the console so old entries expire on their own.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUsername() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Keep in sync with CookQueue.config.SITE_OWNER_USERNAME.
    function siteOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/usernames/jeremy5)
        && get(/databases/$(database)/documents/usernames/jeremy5).data.uid == request.auth.uid;
    }

    // Ids of the recipes shipped in js/data (tests/rules.test.mjs checks this list).
    function siteRecipeId(id) {
      return id in [
        'orange-ginger-air-fryer-chicken-broccoli', 'mexican-hot-chocolate-protein-creami', 'buffalo-chicken-mac-and-cheese',
        'turkey-chorizo-taco-skillet', 'lightened-up-butter-chicken', 'air-fryer-general-tsos-chicken',
        'louisiana-red-beans-and-rice', 'greek-chicken-sheet-pan', 'turkey-bolognese-spaghetti-squash',
        'korean-turkey-rice-bowls', 'mediterranean-turkey-meatballs', 'thai-peanut-chicken-stir-fry',
        'caribbean-jerk-chicken-bowls', 'cajun-vegan-red-beans-rice', 'vegan-creamy-butter-chickpeas',
        'vegan-buffalo-tofu-mac', 'vegan-general-tsos-tofu', 'spicy-buffalo-chickpeas',
        'chickpea-shawarma-dip', 'spinach-turkey-egg-muffins', 'turkey-chorizo-quesadilla',
        'crispy-pita-chips-guacamole', 'chocolate-peanut-butter-creami', 'strawberry-cheesecake-creami',
        'chocolate-fudge-mug-cake', 'mixed-berry-sorbet-creami', 'cinnamon-apple-baked-oats'
      ];
    }

    match /users/{uid} {
      allow read: if true;

      // Create or rename; usernames/{lower} must point back at this user.
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;

      allow delete: if false;
    }

    match /usernames/{name} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == name;

      // Releasing your old name when you rename.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower != name;

      allow update: if false;
    }

    match /recipes/{recipeId} {
      allow read: if true;

      // Shape checks only; the site runs the full recipe rules.
      function validRecipe() {
        let d = request.resource.data;
        return recipeId.matches('^[a-z0-9-]{3,80}$')
          && !d.keys().hasAny(['id', 'rating', 'ratingCount', 'community'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.category in ['main', 'dessert', 'snack']
          && d.ingredients is list && d.ingredients.size() <= 10
          && d.steps is list && d.steps.size() > 0 && d.steps.size() <= 40
          && d.image is map && d.image.url is string && d.image.url.size() <= 400000;
      }

      allow create: if signedIn() && hasUsername()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!siteRecipeId(recipeId) || siteOwner())
        && validRecipe();

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validRecipe();

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /recipes/{recipeId}/reviews/{reviewerUid} {
      allow read: if true;

      function validReview() {
        let d = request.resource.data;
        return d.keys().hasOnly(['stars', 'comment', 'createdAt', 'updatedAt'])
          && d.stars is int && d.stars >= 1 && d.stars <= 5
          && d.comment is string && d.comment.size() <= 1000
          && d.updatedAt == request.time;
      }

      allow create: if signedIn() && hasUsername() && request.auth.uid == reviewerUid
        && recipeId.matches('^[a-z0-9-]{3,80}$')
        && request.resource.data.createdAt == request.time
        && validReview();
      allow update: if signedIn() && request.auth.uid == reviewerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validReview();
      allow delete: if signedIn() && request.auth.uid == reviewerUid;
    }

    // Collection-group read, so the site can load every review in one query.
    match /{path=**}/reviews/{reviewerUid} {
      allow read: if true;
    }

    match /hidden_recipes/{recipeId} {
      allow read: if true;
      allow create: if siteOwner() && siteRecipeId(recipeId)
        && request.resource.data.keys().hasOnly(['hiddenAt'])
        && request.resource.data.hiddenAt == request.time;
      allow update, delete: if siteOwner();
    }

    match /products/{gtin} {
      allow read: if true;

      function validProduct() {
        let d = request.resource.data;
        return gtin.matches('^[0-9]{8,14}$')
          && d.keys().hasOnly(['name', 'brand', 'size', 'unit', 'label', 'group', 'source', 'createdBy', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && (!('brand' in d) || (d.brand is string && d.brand.size() <= 60))
          && (d.size is number || d.size is int) && d.size > 0 && d.size < 100000
          && d.unit in ['oz', 'fl oz', 'cup', 'tbsp', 'tsp', 'can', 'box', 'bunch', 'each', 'scoop']
          && d.label is string && d.label.size() <= 80
          && d.group in ['Protein', 'Dairy', 'Canned', 'Frozen', 'Produce', 'Pantry']
          && d.source in ['openfoodfacts', 'user']
          && d.createdBy == request.auth.uid
          && d.updatedAt == request.time;
      }

      allow create: if signedIn() && hasUsername() && validProduct();
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid && validProduct();
      allow delete: if false;
    }

    match /failed_recipe_imports/{entryId} {
      allow read, update, delete: if false;

      allow create: if signedIn() && hasUsername()
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt', 'rawInput', 'errors', 'context'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.rawInput is string && request.resource.data.rawInput.size() <= 20000
        && request.resource.data.errors is list && request.resource.data.errors.size() <= 20
        && request.resource.data.context is string && request.resource.data.context.size() <= 40;
    }
  }
}
